@model HolidaysModel

@{
    ViewData["Title"] = $"Fridager {Model.Plan.Title}";
    var index = 0;
}

<h2>@ViewData["Title"]</h2>

<p>
    Vi holder ikke kurs på helligdager og i vinterferien og høstferien i Oslo. Kurs som faller på en fridag,
    utsettes til uka etter. Semesteret går fra @Model.Plan.StartDate.ToString("d.M.yyyy") til @Model.Plan.EndDate.ToString("d.M.yyyy").
</p>

<form method="post">
    <table class="table table-sm" style="max-width: 760px">
        <thead>
            <tr>
                <th>Navn</th>
                <th>Fra og med</th>
                <th>Til og med</th>
                <th class="text-center"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var holiday in Model.Holidays)
            {
                <tr>
                    <td><input class="form-control form-control-sm" name="holidays[@index].Name" value="@holiday.Name" /></td>
                    <td><input class="form-control form-control-sm" type="date" name="holidays[@index].From" value="@holiday.From.ToString("yyyy-MM-dd")" /></td>
                    <td><input class="form-control form-control-sm" type="date" name="holidays[@index].To" value="@holiday.To.ToString("yyyy-MM-dd")" /></td>
                    <td class="text-center align-middle">
                        <label class="mb-0 small"><input type="checkbox" name="holidays[@index].Remove" value="true" /> Fjern</label>
                    </td>
                </tr>
                index++;
            }
            @foreach (var suggestion in Model.Suggestions)
            {
                <tr class="table-warning">
                    <td>
                        <input class="form-control form-control-sm" name="holidays[@index].Name" value="@suggestion.Name" />
                        <small class="text-muted">Forslag, ikke lagret ennå</small>
                    </td>
                    <td><input class="form-control form-control-sm" type="date" name="holidays[@index].From" value="@suggestion.From.ToString("yyyy-MM-dd")" /></td>
                    <td><input class="form-control form-control-sm" type="date" name="holidays[@index].To" value="@suggestion.To.ToString("yyyy-MM-dd")" /></td>
                    <td class="text-center align-middle">
                        <input type="hidden" name="holidays[@index].Suggestion" value="true" />
                        <label class="mb-0 small"><input type="checkbox" name="holidays[@index].Include" value="true" checked /> Ta med</label>
                    </td>
                </tr>
                index++;
            }
            @for (var i = 0; i < 3; i++)
            {
                <tr>
                    <td><input class="form-control form-control-sm" name="holidays[@index].Name" placeholder="Ny fridag" /></td>
                    <td><input class="form-control form-control-sm" type="date" name="holidays[@index].From" /></td>
                    <td><input class="form-control form-control-sm" type="date" name="holidays[@index].To" /></td>
                    <td></td>
                </tr>
                index++;
            }
        </tbody>
    </table>

    @if (Model.Suggestions.Count > 0)
    {
        <p class="small text-muted">
            Gule rader er forslag (norske helligdager og skoleferier i Oslo) som ikke er lagret ennå. De tas med når du lagrer, med mindre du fjerner krysset ved «Ta med».
        </p>
    }

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="moveCourses" name="moveCourses" value="true" checked />
        <label class="form-check-label" for="moveCourses">
            Flytt kurs som faller på en fridag til uka etter
            @if (Model.AffectedCourses > 0)
            {
                <strong>(@Model.AffectedCourses kurs faller på fridager nå)</strong>
            }
        </label>
    </div>

    <button type="submit" class="btn btn-success">Lagre fridager</button>
    @if (Model.Suggestions.Count == 0)
    {
        <a class="btn btn-outline-secondary" asp-action="Fridager" asp-route-id="@Model.Plan.Id" asp-route-forslag="true">Vis forslag til helligdager og ferier</a>
    }
    <a class="btn btn-link" asp-action="Plan" asp-route-id="@Model.Plan.Id">Tilbake til planleggingen</a>
</form>
