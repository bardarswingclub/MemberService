@using MemberService.Data.ValueTypes
@using MemberService.Pages.Signup
@model SignupModel

<p>@Html.Markdown(Model.SignupHelp)</p>

@if (Model.RoleSignup)
{
    <div class="form-group mt-4">
        <label>@Localizer["Danserolle"]</label>
        <partial name="_RolePreferences" model="Model.RoleChoices" />
        <small class="form-text text-muted">
            @Html.Markdown(Model.RoleSignupHelp)
        </small>

    </div>

    @if (Model.AllowPartnerSignup)
    {
        <div class="form-group mt-4">
            <label asp-for="Input.PartnerEmail">@Localizer["Partners e-post"]</label>
            <input type="text" class="form-control" asp-for="Input.PartnerEmail" placeholder="epost@eksempel.no">
            <small class="form-text text-muted">
                @Html.Markdown(Model.AllowPartnerSignupHelp ?? "Fyll inn e-post til partner hvis dere er to som ønsker å gå kurs sammen. Begge to må melde seg på og skrive opp hverandres e-post.")
            </small>
            <span asp-validation-for="Input.PartnerEmail" class="text-danger"></span>
        </div>
    }
}

@if (Model.CollectParticipantInfo)
{
    <div class="form-group mt-4">
        <label asp-for="Input.Origin">@Localizer["Hvilken by/land kommer du fra?"]</label>
        <input type="text" class="form-control" asp-for="Input.Origin" maxlength="100" placeholder="@Localizer["F.eks. Oslo, Norge"]">
        <span asp-validation-for="Input.Origin" class="text-danger"></span>
    </div>

    <div class="form-group mt-4">
        <label asp-for="Input.SpecialNeeds">@Localizer["Andre behov, for eksempel allergier"]</label>
        <textarea class="form-control" asp-for="Input.SpecialNeeds" rows="2" maxlength="500" placeholder="@Localizer["Allergier, mattilpasninger eller andre behov vi bør vite om"]"></textarea>
        <span asp-validation-for="Input.SpecialNeeds" class="text-danger"></span>
    </div>
}

<vc:survey-response id=Model.SurveyId />
